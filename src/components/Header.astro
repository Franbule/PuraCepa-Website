---
import MobileMenu from './MobileMenu';

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/catering-cordoba', label: 'Servicios' },
  { href: '/menus-catering-cordoba', label: 'Menús' },
  { href: '/catering-bodas-cordoba', label: 'Bodas' },
  { href: '/catering-eventos-corporativos-cordoba', label: 'Corporativo' },
  { href: '/comuniones-cordoba', label: 'Comuniones' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Logo -->
      <a
        href="/"
        class="flex flex-col leading-none"
        aria-label="PuraCepa Catering — Inicio"
      >
        <span id="logo-text" class="font-serif text-2xl font-light tracking-wide transition-colors duration-300 text-white">PuraCepa</span>
        <span class="text-[0.6rem] font-medium text-dorado tracking-[0.3em] uppercase">Catering</span>
      </a>

      <!-- Navegación desktop -->
      <nav id="nav-links" class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
        {navLinks.slice(0, -1).map((link) => (
          <a
            href={link.href}
            class="nav-link text-sm font-medium transition-colors duration-300 hover:text-dorado tracking-wide text-white/90"
          >
            {link.label}
          </a>
        ))}
        <a
          href="/contacto"
          class="bg-dorado text-white text-sm font-medium px-6 py-2.5 hover:bg-dorado-claro transition-colors duration-200 tracking-wide whitespace-nowrap"
        >
          Solicitar presupuesto
        </a>
      </nav>

      <!-- Menú móvil (React island) -->
      <MobileMenu client:load navLinks={navLinks} />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    function updateHeader() {
      const header = document.getElementById('site-header');
      const logoText = document.getElementById('logo-text');
      const navLinks = document.querySelectorAll('.nav-link');
      if (!header) return;

      const scrolled = window.scrollY > 60;
      header.classList.toggle('header-scrolled', scrolled);

      if (logoText) {
        logoText.style.color = scrolled ? 'var(--color-negro)' : '#ffffff';
      }
      navLinks.forEach(function(link) {
        link.style.color = scrolled ? 'rgb(22 20 18 / 0.75)' : 'rgb(255 255 255 / 0.9)';
      });
    }

    window.addEventListener('scroll', updateHeader, { passive: true });
    document.addEventListener('astro:page-load', updateHeader);
    updateHeader();
  })();
</script>
