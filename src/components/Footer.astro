---
const year = new Date().getFullYear();

const serviceLinks = [
  { href: '/catering-cordoba', label: 'Catering en Córdoba' },
  { href: '/catering-bodas-cordoba', label: 'Catering Bodas' },
  { href: '/catering-eventos-corporativos-cordoba', label: 'Eventos Corporativos' },
  { href: '/comuniones-cordoba', label: 'Comuniones' },
  { href: '/menus-catering-cordoba', label: 'Menús de Catering' },
];

const legalLinks = [
  { href: '/aviso-legal', label: 'Aviso legal' },
  { href: '/politica-privacidad', label: 'Privacidad' },
  { href: '/politica-cookies', label: 'Cookies' },
];
---

<footer class="bg-negro pt-16 pb-8 text-white/65">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">

      <!-- Marca -->
      <div>
        <div class="mb-5">
          <span class="font-serif text-3xl font-light text-white block leading-none">PuraCepa</span>
          <span class="text-[0.6rem] tracking-[0.3em] uppercase text-dorado font-medium">Catering</span>
        </div>
        <p class="text-sm leading-relaxed mb-6">
          Catering premium para bodas, eventos corporativos y celebraciones en Córdoba.
          Gastronomía de calidad y experiencias que perduran.
        </p>
        <!-- Redes sociales — PLACEHOLDER: actualizar hrefs -->
        <div class="flex gap-4" aria-label="Redes sociales">
          <a
            href="#"
            aria-label="Instagram de PuraCepa Catering"
            class="text-white/40 hover:text-dorado transition-colors duration-200"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a
            href="#"
            aria-label="Facebook de PuraCepa Catering"
            class="text-white/40 hover:text-dorado transition-colors duration-200"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="font-serif text-white text-xl mb-5 font-light">Servicios</h3>
        <ul class="space-y-3">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:text-dorado transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="font-serif text-white text-xl mb-5 font-light">Contacto</h3>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-dorado mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Córdoba, Andalucía, España</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-dorado flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <!-- PLACEHOLDER: sustituir por el teléfono real -->
            <a href="tel:+34XXXXXXXXX" class="hover:text-dorado transition-colors duration-200">+34 XXX XXX XXX</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-dorado flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <!-- PLACEHOLDER: sustituir por el email real -->
            <a href="mailto:info@puracepa-catering.es" class="hover:text-dorado transition-colors duration-200">info@puracepa-catering.es</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider + copyright -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-white/35 text-center">
        &copy; {year} PuraCepa Catering. Todos los derechos reservados.
      </p>
      <nav class="flex gap-6 flex-wrap justify-center" aria-label="Páginas legales">
        {legalLinks.map((link) => (
          <a href={link.href} class="text-xs text-white/35 hover:text-dorado transition-colors duration-200">
            {link.label}
          </a>
        ))}
      </nav>
    </div>

  </div>
</footer>
