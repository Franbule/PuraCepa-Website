---
import { Image } from 'astro:assets';
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
  aria-label="Sección principal"
>
  <!-- Imagen de fondo -->
  <Image
    src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=1920&q=80&fit=crop&auto=format"
    alt="Elegante recepción de boda con iluminación cálida y mesas decoradas con flores"
    width={1920}
    height={1080}
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Overlay gradiente oscuro -->
  <div class="absolute inset-0 bg-gradient-to-b from-negro/60 via-negro/45 to-negro/65"></div>

  <!-- Contenido -->
  <div class="relative z-10 text-center text-white px-4 max-w-4xl mx-auto pt-20">
    <span class="section-label text-dorado-claro">
      Catering premium en Córdoba
    </span>

    <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-light mb-5 leading-[1.1] tracking-wide">
      PuraCepa Catering
    </h1>

    <p class="font-serif text-xl sm:text-2xl font-light text-white/90 mb-5 italic tracking-wide">
      "Sabor y experiencia para crear recuerdos inolvidables."
    </p>

    <p class="text-white/75 text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed font-light">
      Especialistas en bodas, eventos corporativos, comuniones y
      celebraciones privadas en Córdoba y provincia.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/contacto"
        class="inline-block bg-dorado text-white px-8 py-4 text-sm font-medium tracking-widest uppercase hover:bg-dorado-claro transition-colors duration-300"
      >
        Solicitar presupuesto
      </a>
      <a
        href="#servicios"
        class="inline-block border border-white/50 text-white px-8 py-4 text-sm font-medium tracking-widest uppercase hover:bg-white/10 hover:border-white transition-colors duration-300"
      >
        Ver servicios
      </a>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 text-white/50 pointer-events-none">
    <span class="text-[0.6rem] tracking-[0.2em] uppercase font-medium">Descubre</span>
    <div class="w-px h-10 bg-gradient-to-b from-white/50 to-transparent"></div>
  </div>
</section>
