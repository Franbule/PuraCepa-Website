---
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

// Fuentes self-hosted (mejor rendimiento y RGPD)
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.jpg',
  ogType = 'website',
} = Astro.props;

const SITE = 'https://puracepa-catering.es';
const canonicalURL = canonical
  ? `${SITE}${canonical}`
  : `${SITE}${Astro.url.pathname.replace(/\/$/, '') || '/'}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Caterer'],
  name: 'PuraCepa Catering',
  url: SITE,
  description: 'Catering premium para bodas, eventos corporativos, comuniones y celebraciones en Córdoba. Gastronomía de calidad y experiencias inolvidables.',
  // PLACEHOLDER: sustituir por el teléfono real
  telephone: '+34XXXXXXXXX',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Córdoba',
    addressRegion: 'Andalucía',
    addressCountry: 'ES',
  },
  areaServed: ['Córdoba', 'Andalucía'],
  priceRange: '€€€',
  image: `${SITE}/og-image.jpg`,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#BFA15F" />

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      ogImage={`${SITE}${ogImage}`}
      ogType={ogType}
    />

    <!-- JSON-LD LocalBusiness / Caterer -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Transiciones de página suaves -->
    <ClientRouter />
  </head>

  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-dorado focus:text-white focus:px-4 focus:py-2 focus:text-sm"
    >
      Saltar al contenido principal
    </a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />

    <!-- IntersectionObserver para animaciones de scroll -->
    <script is:inline>
      function initScrollAnimations() {
        const els = document.querySelectorAll('[data-animate]');
        if (!els.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );

        els.forEach((el) => {
          el.classList.remove('in-view');
          observer.observe(el);
        });
      }

      document.addEventListener('astro:page-load', initScrollAnimations);
      initScrollAnimations();
    </script>
  </body>
</html>
